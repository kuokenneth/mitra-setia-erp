# Core application settings
DATABASE_URL=
JWT_SECRET=
FRONTEND_URL=https://mitra-setia-erp.netlify.app

# Email notifications via Resend
# Verify your company domain in Resend before enabling this in production.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Mitra Setia ERP <notifikasi@your-domain.com>
# Separate multiple recipients with commas.
OWNER_NOTIFICATION_EMAIL=owner@your-domain.com,second-owner@your-domain.com
# Optional address that receives replies.
EMAIL_REPLY_TO=
