# Core application settings
DATABASE_URL=
JWT_SECRET=
FRONTEND_URL=https://mitra-setia-erp.netlify.app
BACKEND_URL=https://mitra-setia-erp.onrender.com

# Email notifications via Resend
# Verify your company domain in Resend before enabling this in production.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Mitra Setia ERP <notifikasi@your-domain.com>
# Separate multiple recipients with commas.
OWNER_NOTIFICATION_EMAIL=owner@your-domain.com,riswanto.mitrasetia@gmail.com
# Optional address that receives replies.
EMAIL_REPLY_TO=

# Minutes a truck must remain inside the destination geofence before its trip
# is locked as arrived and waiting for weighbridge evidence.
GOLACAK_ARRIVAL_DWELL_MINUTES=30

# Optional external market prices (backend only). No marketplace scraping is performed.
# Obtain an authorized SerpApi account/API key before enabling live searches.
SERPAPI_API_KEY=
MARKET_SERPAPI_ENABLED=false
# Annual internal spend threshold for market negotiation alerts, in IDR.
MARKET_HIGH_SPEND_IDR=10000000
