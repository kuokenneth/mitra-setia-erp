generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////////////////
// ENUMS
////////////////////////////////////////////////////
enum UserRole {
  OWNER
  ADMIN
  SPAREPART_ADMIN
  STAFF
  DRIVER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BREAK
}

enum StockUnitStatus {
  IN_STOCK
  ASSIGNED
  SCRAPPED
  LOST
}

enum StockMoveType {
  IN // purchase / receiving
  OUT // used / issued
  ADJUST // stock opname adjustment
  TRANSFER // moved between locations
}

enum TruckStatus {
  INACTIVE
  READY
  MAINTENANCE
  DISPATCH
  WAITING_BACKHAUL
  RETURNING_EMPTY
}

enum MaintenanceStatus {
  OPEN
  DONE
  CANCELLED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderType {
  OUTBOUND
  RETURN
}

enum CargoCategory {
  FERTILIZER
  CANGKANG
  MATERIAL
}

enum TripStatus {
  PLANNED
  DISPATCHED // UI label: ON_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
}

enum TripPurpose {
  DELIVERY
  EMPTY_RETURN
}

enum ExpensePaymentMethod {
  BANK_TRANSFER
  CASH
  OTHER
}

enum ExpenseStatus {
  SUBMITTED
  PAID
  APPROVED
}

enum PurchaseRequestStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT_TO_SUPPLIER
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
}

enum PurchasePaymentStatus {
  UNPAID
  WAITING_PAYMENT_APPROVAL
  PARTIALLY_PAID
  PAID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

enum ReceivablePaymentMethod {
  BANK_TRANSFER
  CASH
  OTHER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  POSTED
  VOID
}

////////////////////////////////////////////////////
// MODELS
////////////////////////////////////////////////////
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  password  String
  phone     String?
  role      UserRole   @default(ADMIN)
  isActive  Boolean    @default(true)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())

  driver         Driver?
  stockMovements StockMovement[] @relation("StockMovementByUser")
  drivingTrucks  Truck[]         @relation("TruckDriverUser")
  trips          Trip[]

  sparePartAssignmentsCreated TruckSparePartAssignment[] @relation("SparePartAssignmentCreatedBy")
  expensesCreated             Expense[]                  @relation("ExpenseCreatedBy")
  expensesApproved            Expense[]                  @relation("ExpenseApprovedBy")
  expensesProofed             Expense[]                  @relation("ExpenseProofBy")
  purchaseRequests            PurchaseRequest[]          @relation("PurchaseRequestCreatedBy")
  purchaseRequestsApproved    PurchaseRequest[]          @relation("PurchaseRequestApprovedBy")
  purchaseOrdersCreated       PurchaseOrder[]            @relation("PurchaseOrderCreatedBy")
  goodsReceiptsCreated        GoodsReceipt[]             @relation("GoodsReceiptCreatedBy")
  purchasePaymentsCreated     PurchasePayment[]          @relation("PurchasePaymentCreatedBy")
  purchasePaymentsApproved    PurchasePayment[]          @relation("PurchasePaymentApprovedBy")
  invoicesCreated             Invoice[]                  @relation("InvoiceCreatedBy")
  receivablePaymentsCreated   ReceivablePayment[]        @relation("ReceivablePaymentCreatedBy")
  ordersCreated               Order[]                    @relation("OrderCreatedBy")
  auditLogs                   AuditLog[]                  @relation("AuditLogActor")
  journalEntriesCreated       JournalEntry[]             @relation("JournalEntryCreatedBy")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation("AuditLogActor", fields: [userId], references: [id], onDelete: SetNull)
  actorName  String?
  actorEmail String?
  actorRole  String?
  action     String
  method     String
  resource   String
  entityId   String?
  path       String
  statusCode Int
  changes    Json
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([resource])
  @@index([action])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  phone          String?
  email          String?
  address        String?
  bankName       String?
  bankAccount    String?
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
}

model PurchaseRequest {
  id             String                @id @default(cuid())
  number         String                @unique
  status         PurchaseRequestStatus @default(DRAFT)
  urgency        String                @default("NORMAL")
  purpose        String?
  truckId        String?
  reason         String
  notes          String?
  createdById    String
  createdBy      User                  @relation("PurchaseRequestCreatedBy", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?                 @relation("PurchaseRequestApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  approvalNotes  String?
  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status])
}

model PurchaseRequestItem {
  id          String          @id @default(cuid())
  requestId   String
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item            @relation(fields: [itemId], references: [id])
  originalQty Float
  approvedQty Float?
  notes       String?
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  number           String              @unique
  requestId        String
  request          PurchaseRequest     @relation(fields: [requestId], references: [id])
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  status           PurchaseOrderStatus @default(DRAFT)
  tax              Int                 @default(0)
  shippingCost     Int                 @default(0)
  discount         Int                 @default(0)
  paymentTerms     String?
  deliveryAddress  String?
  estimatedArrival DateTime?
  createdById      String
  createdBy        User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  items            PurchaseOrderItem[]
  receipts         GoodsReceipt[]
  payments         PurchasePayment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
}

model PurchaseOrderItem {
  id              String             @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item               @relation(fields: [itemId], references: [id])
  qty             Float
  unitPrice       Int
  receivedQty     Float              @default(0)
  receiptItems    GoodsReceiptItem[]
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  number          String             @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  locationId      String
  location        InventoryLocation  @relation(fields: [locationId], references: [id])
  deliveryNote    String?
  notes           String?
  receivedAt      DateTime           @default(now())
  createdById     String
  createdBy       User               @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id])
  items           GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id                  String            @id @default(cuid())
  receiptId           String
  receipt             GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  qty                 Float
  condition           String            @default("GOOD")
}

model PurchasePayment {
  id              String                @id @default(cuid())
  number          String                @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  amount          Int
  method          String
  reference       String?
  status          PurchasePaymentStatus @default(WAITING_PAYMENT_APPROVAL)
  paidAt          DateTime?
  createdById     String
  createdBy       User                  @relation("PurchasePaymentCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?                 @relation("PurchasePaymentApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  createdAt       DateTime              @default(now())
}

model Driver {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  licenseNo String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  orders   Order[]
  invoices Invoice[]
}

////////////////////////////////////////////////////
// ORDER + TRIP
////////////////////////////////////////////////////
model Order {
  id      String @id @default(cuid())
  orderNo String @unique

  orderType OrderType @default(OUTBOUND)

  // optional customer relation
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // fallback if no Customer module used
  customerName String?

  // core order info
  description   String?
  cargoName     String?
  cargoCategory CargoCategory @default(FERTILIZER)
  qty           Float?
  unit          String? // "TON", "BAG", etc.

  fromText  String? // pickup / warehouse
  toText    String? // destination
  plannedAt DateTime?

  notes  String?
  status OrderStatus @default(DRAFT)

  // User who originally entered the order. Optional for legacy records.
  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // backhaul linkage
  backhaulOfOrderId String?
  backhaulOfOrder   Order?  @relation("BackhaulLink", fields: [backhaulOfOrderId], references: [id])
  backhaulOrders    Order[] @relation("BackhaulLink")

  // relations
  trips            Trip[]
  proofs           OrderProof[]
  materialInvoices MaterialInvoice[]
  invoice          Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([plannedAt])
  @@index([customerName])
  @@index([toText])
  @@index([backhaulOfOrderId])
  @@index([createdById])
}

////////////////////////////////////////////////////
// INVOICE + RECEIVABLE
////////////////////////////////////////////////////
model Invoice {
  id             String              @id @default(cuid())
  number         String              @unique
  orderId        String              @unique
  order          Order               @relation(fields: [orderId], references: [id])
  customerId     String?
  customer       Customer?           @relation(fields: [customerId], references: [id])
  customerName   String
  customerPhone  String?
  billingAddress String?
  status         InvoiceStatus       @default(DRAFT)
  issuedAt       DateTime            @default(now())
  dueAt          DateTime
  subtotal       Int
  tax            Int                 @default(0)
  discount       Int                 @default(0)
  total          Int
  notes          String?
  sentAt         DateTime?
  paidAt         DateTime?
  createdById    String
  createdBy      User                @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  payments       ReceivablePayment[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
  @@index([dueAt])
  @@index([customerId])
}

model ReceivablePayment {
  id          String                  @id @default(cuid())
  number      String                  @unique
  invoiceId   String
  invoice     Invoice                 @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Int
  method      ReceivablePaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?
  receivedAt  DateTime                @default(now())
  createdById String
  createdBy   User                    @relation("ReceivablePaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime                @default(now())

  @@index([invoiceId])
  @@index([receivedAt])
}

model Trip {
  id String @id @default(cuid())

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  truckId String
  truck   Truck  @relation(fields: [truckId], references: [id])

  // driver is a User with role DRIVER (enforce in backend)
  driverUserId String?
  driverUser   User?   @relation(fields: [driverUserId], references: [id])

  status            TripStatus  @default(PLANNED)
  purpose           TripPurpose @default(DELIVERY)
  operationalReason String?

  // ✅ quantity per trip (for contract decrement)
  qtyPlanned Float? // planned load for this trip
  qtyActual  Float? // optional, fill when ARRIVED/COMPLETED
  unitSnap   String? // ✅ ADD THIS

  // dates
  plannedDepartAt DateTime?
  dispatchedAt    DateTime?
  arrivedAt       DateTime?
  completedAt     DateTime?

  // snapshot fields (for historical correctness)
  plateNumberSnap String?
  driverNameSnap  String?
  fromText        String?
  toText          String?

  dispatchLetter   DispatchLetter?
  materialInvoices MaterialInvoice[]

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([truckId])
  @@index([driverUserId])
  @@index([status])
}

model OrderProof {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  url      String
  fileName String?
  mimeType String?
  size     Int?

  createdAt DateTime @default(now())

  @@index([orderId])
}

model MaterialInvoice {
  id            String   @id @default(cuid())
  orderId       String
  tripId        String
  number        String
  materialName  String
  qty           Float
  unit          String
  issuedAt      DateTime @default(now())
  notes         String?
  proofUrl      String?
  proofFileName String?
  proofMimeType String?
  proofSize     Int?
  createdAt     DateTime @default(now())

  order Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trip  Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lines MaterialInvoiceLine[]

  @@unique([orderId, number])
  @@index([orderId])
  @@index([tripId])
}

model MaterialInvoiceLine {
  id                String   @id @default(cuid())
  materialInvoiceId String
  ppNumber          String?
  poNumber          String?
  itemName          String
  qty               Float
  unit              String
  totalKg           Float?
  totalAmount       Int?
  createdAt         DateTime @default(now())

  materialInvoice MaterialInvoice @relation(fields: [materialInvoiceId], references: [id], onDelete: Cascade)

  @@index([materialInvoiceId])
}

model DispatchLetter {
  id String @id @default(cuid())

  tripId String @unique
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  number   String   @unique // e.g. "SP-2026-00045"
  city     String?
  issuedAt DateTime @default(now())

  pdfUrl String? // generated pdf url

  // snapshot fields (letter stays same even if order changes)
  recipientName String?
  cargoName     String?
  driverName    String?
  plateNumber   String?
  loadDateText  String?
  destination   String?

  createdAt DateTime @default(now())
}

////////////////////////////////////////////////////
// TRUCK
////////////////////////////////////////////////////
model Truck {
  id          String  @id @default(cuid())
  plateNumber String  @unique
  brand       String?
  model       String?
  year        Int?
  vin         String? @unique

  stnkExpiry DateTime?

  // Operational position. Updated automatically when a trip arrives/completes.
  baseLocation         String?   @default("Medan")
  currentLocation      String?   @default("Medan")
  locationUpdatedAt    DateTime?
  availableForBackhaul Boolean   @default(false)
  idleSince            DateTime?

  status    TruckStatus @default(READY)
  createdAt DateTime    @default(now())

  trips Trip[] // ✅ Trips for dispatching

  driverUserId String?
  driverUser   User?   @relation("TruckDriverUser", fields: [driverUserId], references: [id])

  maintenances         TruckMaintenance[]
  sparePartAssignments TruckSparePartAssignment[]
  monthlyCosts         TruckMonthlyCost[]
  expenses             Expense[]

  @@index([driverUserId])
  @@index([stnkExpiry])
  @@index([currentLocation])
  @@index([availableForBackhaul])
}

model TruckMonthlyCost {
  id           String   @id @default(cuid())
  truckId      String
  truck        Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  month        DateTime
  depreciation Int      @default(0)
  insurance    Int      @default(0)
  taxPermit    Int      @default(0)
  driverSalary Int      @default(0)
  lease        Int      @default(0)
  overhead     Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([truckId, month])
  @@index([month])
}

model TruckMaintenance {
  id         String            @id @default(cuid())
  truckId    String
  title      String
  note       String?
  odometerKm Int?
  status     MaintenanceStatus @default(OPEN)
  createdAt  DateTime          @default(now())
  doneAt     DateTime?
  photos     String[]          @default([])

  truck     Truck           @relation(fields: [truckId], references: [id])
  movements StockMovement[]

  sparePartAssignments TruckSparePartAssignment[]
}

////////////////////////////////////////////////////
// INVENTORY
////////////////////////////////////////////////////
model StockUnit {
  id           String  @id @default(cuid())
  itemId       String
  locationId   String?
  serialNumber String? @unique
  barcode      String? @unique

  purchasePrice Int?
  currency      String?   @default("IDR")
  purchasedAt   DateTime?

  status     StockUnitStatus @default(IN_STOCK)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  scrappedAt DateTime?

  item     Item               @relation(fields: [itemId], references: [id])
  location InventoryLocation? @relation(fields: [locationId], references: [id])

  assignments TruckSparePartAssignment[]
  movements   StockMovement[]

  @@index([itemId])
  @@index([locationId])
  @@index([status])
}

model TruckSparePartAssignment {
  id String @id @default(cuid())

  truckId     String
  stockUnitId String

  installedAt DateTime
  removedAt   DateTime?

  // ✅ Snapshot values at install time (important for reporting & audit)
  installCost Int? // copy from StockUnit.purchasePrice when installed
  currency    String? @default("IDR")

  note        String?
  createdById String?
  createdBy   User?   @relation("SparePartAssignmentCreatedBy", fields: [createdById], references: [id])

  maintenanceId String?
  maintenance   TruckMaintenance? @relation(fields: [maintenanceId], references: [id])

  truck     Truck     @relation(fields: [truckId], references: [id])
  stockUnit StockUnit @relation(fields: [stockUnitId], references: [id])

  createdAt DateTime @default(now())

  @@index([truckId])
  @@index([stockUnitId])
  @@index([installedAt])
  @@index([removedAt])
}

model Item {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String   @unique
  unit         String   @default("PCS")
  isSerialized Boolean  @default(false)
  createdAt    DateTime @default(now())

  stocks               InventoryStock[]
  movements            StockMovement[]
  stockUnits           StockUnit[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
}

model InventoryLocation {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  stocks    InventoryStock[]
  fromMoves StockMovement[]  @relation("FromLocation")
  toMoves   StockMovement[]  @relation("ToLocation")

  stockUnits    StockUnit[]
  goodsReceipts GoodsReceipt[]
}

model InventoryStock {
  id         String   @id @default(cuid())
  itemId     String
  locationId String
  qty        Float    @default(0)
  updatedAt  DateTime @updatedAt

  item     Item              @relation(fields: [itemId], references: [id])
  location InventoryLocation @relation(fields: [locationId], references: [id])

  @@unique([itemId, locationId])
}

model StockMovement {
  id        String        @id @default(cuid())
  type      StockMoveType
  itemId    String
  qty       Float
  note      String?
  createdAt DateTime      @default(now())

  createdById String?
  createdBy   User?   @relation("StockMovementByUser", fields: [createdById], references: [id])

  fromLocationId String?
  toLocationId   String?

  fromLocation InventoryLocation? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation   InventoryLocation? @relation("ToLocation", fields: [toLocationId], references: [id])

  maintenanceId String?
  maintenance   TruckMaintenance? @relation(fields: [maintenanceId], references: [id])

  stockUnitId String?
  stockUnit   StockUnit? @relation(fields: [stockUnitId], references: [id])

  item Item @relation(fields: [itemId], references: [id])

  @@index([stockUnitId])
  @@index([itemId])
  @@index([createdById])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model Expense {
  id String @id @default(cuid())

  status        ExpenseStatus        @default(SUBMITTED)
  paymentMethod ExpensePaymentMethod @default(BANK_TRANSFER)
  bankName      String?
  accountName   String?
  accountNumber String?

  amount   Int
  currency String @default("IDR")

  reason     String
  clientName String?
  notes      String?

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id])

  truckId String?
  truck   Truck?  @relation(fields: [truckId], references: [id])

  proofUrl      String?
  proofFileName String?
  proofMimeType String?
  proofSize     Int?
  paidAt        DateTime?

  proofUploadedById String?
  proofUploadedBy   User?   @relation("ExpenseProofBy", fields: [proofUploadedById], references: [id])

  createdById String?
  createdBy   User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([paymentMethod])
  @@index([bankName])
  @@index([accountName])
  @@index([accountNumber])
  @@index([clientName])
  @@index([tripId])
  @@index([truckId])
  @@index([proofUploadedById])
  @@index([createdById])
  @@index([approvedById])
  @@index([createdAt])
}

////////////////////////////////////////////////////
// ACCOUNTING
////////////////////////////////////////////////////
model Account {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  type      AccountType
  isActive  Boolean       @default(true)
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now())
  lines     JournalLine[]

  @@index([type])
}

model JournalEntry {
  id          String        @id @default(cuid())
  number      String        @unique
  date        DateTime      @default(now())
  description String
  sourceType  String?
  sourceId    String?
  status      JournalStatus @default(POSTED)
  createdById String?
  createdBy   User?         @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  lines       JournalLine[]
  createdAt   DateTime      @default(now())

  @@unique([sourceType, sourceId])
  @@index([date])
  @@index([status])
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  description String?
  debit       Int          @default(0)
  credit      Int          @default(0)

  @@index([entryId])
  @@index([accountId])
}

model StoredFile {
  id        String   @id @default(cuid())
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}
