.landing{--green:#0b6038;--dark:#09291c;--ink:#172b22;--muted:#68776f;--line:#dbe4de;--wash:#f3f7f4;color:var(--ink);background:#fff;font-family:"Manrope",sans-serif;overflow:hidden}.landing *{box-sizing:border-box}.landing h1,.landing h2,.landing h3,.landing p{margin-top:0}.landing-shell{width:min(1220px,calc(100% - 64px));margin:auto}.landing-kicker{display:flex;align-items:center;gap:10px;color:var(--green);font-size:10px;font-weight:800;letter-spacing:.17em}.landing-kicker:before{content:"";width:25px;height:2px;background:currentColor}.landing-kicker.light{color:#b9dfa7}.landing-hero{position:relative;min-height:760px;display:flex;align-items:center;padding:130px 0 90px;background:#17372a;color:#fff}.hero-photo,.hero-shade{position:absolute;inset:0;width:100%;height:100%}.hero-photo{object-fit:cover}.hero-shade{background:linear-gradient(90deg,rgba(4,28,18,.91) 0%,rgba(5,34,22,.79) 38%,rgba(5,30,20,.22) 72%,rgba(5,30,20,.12)),linear-gradient(0deg,rgba(3,24,16,.42),transparent 52%)}.hero-content{position:relative;z-index:1}.hero-content h1{max-width:760px;margin:24px 0 25px;font-size:clamp(52px,6.2vw,82px);font-weight:700;line-height:1.01;letter-spacing:-.055em}.hero-content p{max-width:620px;margin-bottom:34px;color:#d1dcd6;font-size:16px;line-height:1.75}.landing-actions{display:flex;flex-wrap:wrap;gap:10px}.landing-btn{display:inline-flex;min-height:50px;align-items:center;justify-content:center;gap:10px;padding:0 21px;border:1px solid transparent;border-radius:8px;font-size:12px;font-weight:800;text-decoration:none;transition:.18s}.landing-btn:hover{transform:translateY(-1px)}.landing-btn.primary{background:#fff;color:var(--dark)}.landing-btn.ghost{border-color:#ffffff66;color:#fff}.hero-caption{position:absolute;z-index:1;right:32px;bottom:28px;display:flex;gap:28px;color:#d8e0dc;font-size:9px;font-weight:700;letter-spacing:.05em}.hero-caption span{display:flex;align-items:center;gap:6px}
.landing-about{padding:104px 0}.about-grid{display:grid;grid-template-columns:.62fr 1.38fr;gap:70px}.about-label{display:flex;justify-content:space-between;flex-direction:column}.about-index{color:#bdc8c1;font-size:11px;font-weight:800}.about-grid h2,.section-heading h2,.fleet-heading h2,.why-copy h2,.contact-card h2{max-width:780px;margin-bottom:0;font-size:clamp(35px,4.4vw,54px);line-height:1.12;letter-spacing:-.047em}.about-copy{display:grid;grid-template-columns:1fr 1fr;gap:35px;margin-top:36px;padding-top:28px;border-top:1px solid var(--line)}.about-copy p{margin:0;color:var(--muted);font-size:13px;line-height:1.8}.landing-services{padding:98px 0;background:var(--wash);border-block:1px solid var(--line)}.section-heading{display:grid;grid-template-columns:1.2fr .75fr;align-items:end;gap:80px;margin-bottom:43px}.section-heading h2{margin-top:17px}.section-heading>p{margin-bottom:5px;color:var(--muted);font-size:13px;line-height:1.8}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);overflow:hidden;border:1px solid var(--line);border-radius:13px;background:#fff}.service-grid article{min-height:300px;padding:31px}.service-grid article+article{border-left:1px solid var(--line)}.service-top{display:flex;align-items:center;justify-content:space-between}.service-top>span{display:grid;width:43px;height:43px;place-items:center;border-radius:8px;background:#e6f1ea;color:var(--green);font-size:18px}.service-top small{color:#9ba7a0;font-size:9px;font-weight:800}.service-grid h3{margin:65px 0 13px;font-size:18px}.service-grid p{margin:0;color:var(--muted);font-size:12px;line-height:1.75}
.landing-fleet{padding:104px 0;background:var(--dark);color:#fff}.fleet-heading{display:grid;grid-template-columns:1.15fr .85fr;align-items:end;gap:70px;margin-bottom:43px}.fleet-heading .landing-kicker{grid-column:1/-1}.fleet-heading h2{max-width:680px}.fleet-heading p{margin-bottom:3px;color:#aebdb5;font-size:13px;line-height:1.75}.fleet-gallery{display:grid;grid-template-columns:1.35fr .65fr;gap:14px}.fleet-gallery figure{position:relative;height:480px;margin:0;overflow:hidden;border-radius:11px;background:#1b4230}.fleet-gallery img{width:100%;height:100%;object-fit:cover;filter:saturate(.8)}.fleet-gallery figcaption{position:absolute;right:0;bottom:0;left:0;display:flex;justify-content:space-between;gap:20px;padding:20px;background:linear-gradient(0deg,rgba(4,27,18,.88),transparent);font-size:10px}.fleet-gallery figcaption span{color:#b4c5bc}.fleet-gallery figcaption strong{font-size:11px}.landing-why{padding:105px 0}.why-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:center}.why-copy h2{margin:18px 0 22px}.why-copy>p{max-width:560px;color:var(--muted);font-size:13px;line-height:1.85}.text-link{display:inline-flex;align-items:center;gap:8px;margin-top:14px;color:var(--green);font-size:11px;font-weight:800;text-decoration:none}.principle-list{border-top:1px solid var(--line)}.principle-list>div{display:grid;grid-template-columns:50px 1fr;align-items:center;padding:21px 0;border-bottom:1px solid var(--line)}.principle-list>div>span{color:#9ca8a1;font-size:9px;font-weight:800}.principle-list p{display:flex;align-items:center;gap:10px;margin:0;font-size:12px;font-weight:700}.principle-list svg{color:var(--green);font-size:16px}.landing-contact{padding:0 0 86px}.contact-card{display:flex;align-items:center;justify-content:space-between;gap:60px;padding:53px 58px;border-radius:14px;background:var(--green);color:#fff}.contact-card h2{margin:17px 0 13px}.contact-card p{max-width:720px;margin:0;color:#c7d9cf;font-size:12px;line-height:1.75}.contact-actions{display:flex;flex:none;align-items:center;flex-direction:column;gap:13px}.light-btn{background:#fff;color:var(--dark)}.contact-actions>span{display:flex;align-items:center;gap:6px;color:#b7cec1;font-size:8px}
.landing-footer{padding:38px 0;border-top:1px solid var(--line);background:#f7f9f8}.footer-grid{display:grid;grid-template-columns:1.1fr .9fr auto auto;align-items:center;gap:30px}.footer-brand{display:flex;align-items:center;gap:11px}.footer-brand img{width:40px;height:40px;border-radius:8px;object-fit:contain}.footer-brand span{display:flex;flex-direction:column}.footer-brand strong{font-size:11px}.footer-brand small{color:#839087;font-size:7px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.landing-footer>div>p{margin:0;color:#7c8b83;font-size:8px}.landing-footer nav{display:flex;gap:17px}.landing-footer nav a,.footer-portal{color:#52635a;font-size:9px;font-weight:700;text-decoration:none}.footer-portal{display:flex;align-items:center;gap:6px;white-space:nowrap}.copyright{grid-column:1/-1;padding-top:22px;border-top:1px solid #e1e7e3;color:#8b9891;font-size:8px}
@media(max-width:1000px){.landing-hero{min-height:680px}.about-grid{grid-template-columns:.45fr 1.55fr}.why-grid{gap:50px}.contact-card{align-items:flex-start;flex-direction:column}.footer-grid{grid-template-columns:1fr auto}.landing-footer>div>p{display:none}.landing-footer nav{grid-row:2}.copyright{grid-column:1/-1}}
@media(max-width:760px){.landing-shell{width:min(100% - 34px,620px)}.landing-hero{min-height:700px;padding-top:120px}.hero-content h1{font-size:clamp(43px,12vw,61px)}.hero-caption{display:none}.about-grid,.section-heading,.fleet-heading,.why-grid{grid-template-columns:1fr;gap:25px}.about-label{display:block}.about-index{display:none}.about-copy{grid-template-columns:1fr}.service-grid{grid-template-columns:1fr}.service-grid article{min-height:auto}.service-grid article+article{border-top:1px solid var(--line);border-left:0}.service-grid h3{margin-top:38px}.fleet-heading .landing-kicker{grid-column:auto}.fleet-gallery{grid-template-columns:1fr}.fleet-gallery figure{height:360px}.fleet-gallery figure+figure{height:270px}.fleet-gallery figcaption{align-items:flex-start;flex-direction:column}.landing-about,.landing-services,.landing-fleet,.landing-why{padding-block:76px}.contact-card{padding:36px 28px}.contact-actions{width:100%;align-items:flex-start}.footer-grid{grid-template-columns:1fr}.landing-footer nav{grid-row:auto;flex-wrap:wrap}.copyright{grid-column:auto}}
@media(max-width:430px){.landing-shell{width:calc(100% - 28px)}.landing-hero{min-height:730px}.landing-actions{display:grid}.landing-btn{width:100%}.contact-actions .landing-btn{width:100%}.footer-portal{margin-top:4px}}
@media(prefers-reduced-motion:reduce){.landing-btn{transition:none}}

.footer-grid{grid-template-columns:1.1fr .9fr auto auto auto}
.footer-brand{color:var(--ink);text-decoration:none}
@media(max-width:1000px){.footer-grid{grid-template-columns:1fr auto}.footer-portal{justify-self:end}}
@media(max-width:760px){.footer-grid{grid-template-columns:1fr}.footer-portal{justify-self:start}}
